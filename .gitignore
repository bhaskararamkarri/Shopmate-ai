# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage
/playwright-report
/test-results

# Next.js Build Outputs
/.next/
/out/
/build

# Operating System & Logs
.DS_Store
Thumbs.db
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment Variables (Protect secrets, allow example)
.env*
!.env.example

# Vercel & Deployment
.vercel

# Diagnostic Scratch & Workspaces
/scratch/
/.taste-skill/
/.superpowers/
/supabase/.temp/

# TypeScript Build Cache
*.tsbuildinfo
next-env.d.ts
