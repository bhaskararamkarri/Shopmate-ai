# ShopMate AI — server environment variables
# Copy to .env.local and fill in. All of these are server-side only; they are
# never exposed to the browser.

# Channel3 Product API — https://docs.trychannel3.com
# Get a free developer key at https://trychannel3.com/sign-up/developer
# (1,000 free search credits/month; product-detail calls are free).
# Leave empty to run the store on the labeled demo catalog.
CHANNEL3_API_KEY=

# Optional: outbound Channel3 request timeout in ms (default 8000, clamp 1000–20000).
CHANNEL3_TIMEOUT_MS=8000

# AI provider: "groq" (primary cloud), "google" (Gemini), or "ollama" (local).
SHOPMATE_AI_PROVIDER=groq

# Model id for the selected provider. Defaults per provider:
#   groq=openai/gpt-oss-120b, google=gemini-3.8-flash, ollama=gemma3:4b
SHOPMATE_AI_MODEL=

# Groq API key (https://console.groq.com/keys) — required when
# SHOPMATE_AI_PROVIDER=groq. Server-side only; never exposed to the browser.
GROQ_API_KEY=

# Google Gemini API key (https://aistudio.google.com/apikey) — required only
# when SHOPMATE_AI_PROVIDER=google. AI Studio keys start with "AIza".
GEMINI_API_KEY=

# Optional: outbound AI request timeout in ms for Groq (default 30000, clamp 5000–120000).
SHOPMATE_AI_TIMEOUT_MS=

# PayPal REST API — https://developer.paypal.com/api/rest/authentication
# Sandbox only in Phase 5. Server-side only: these values are never exposed
# to the browser. Create sandbox credentials at
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Durable payment storage (Phase 6B) — server-only secrets.
# Never prefix any of these with NEXT_PUBLIC_; they must never reach a client
# bundle. See README.md for migration and verification steps.
# ---------------------------------------------------------------------------

# "postgres" (durable) or "memory" (local/test only). Production refuses
# "memory": pending orders would be lost on restart and are not shared between
# instances. When unset, the app uses Postgres if DATABASE_URL is present,
# otherwise memory in development and tests.
# SHOPMATE_PAYMENT_STORE: "postgres" (recommended/production default) or "memory".
# When running standalone demos on production builds without Postgres, set:
# SHOPMATE_ALLOW_IN_MEMORY_DEMO=true
SHOPMATE_PAYMENT_STORE=postgres
SHOPMATE_ALLOW_IN_MEMORY_DEMO=false

# Direct PostgreSQL connection string for the Supabase project.
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# SECRET. This is also the migration credential. Use .env.local (ignored by git)
# and restart the dev server after changing it. Do not expose it through a
# NEXT_PUBLIC_ variable or any route response.
DATABASE_URL=

# Recommended: a stable 32+ byte random secret used to derive capture tokens.
# Precedence: CAPTURE_TOKEN_SECRET -> SUPABASE_SECRET_KEY ->
# SUPABASE_SERVICE_ROLE_KEY -> DATABASE_URL. Changing this value invalidates
# capture tokens for orders that are still pending.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTURE_TOKEN_SECRET=

# Guest checkout session signing secret (Phase 6C).
# Used to sign the HMAC-SHA256 guest session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHOPMATE_GUEST_SESSION_SECRET=

# Optional Supabase API values. The direct-Postgres adapter does not require
# them; SUPABASE_SECRET_KEY is only consulted as optional capture-token key
# material. Both are server-only secrets.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional publishable key. This app does not currently use the Supabase Data
# API, but the name is listed for completeness. Publishable keys are safe to
# expose; secret/service-role keys are not.
# SUPABASE_PUBLISHABLE_KEY=

# Optional: a disposable database that already has the Phase 6B migration
# applied, used only by the gated Postgres integration test. Never point this
# at production. The test leaves uniquely-keyed rows in place and never
# deletes or truncates.
# PAYMENTS_TEST_DATABASE_URL=
